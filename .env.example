# Copy to .env.local. Values below work for local development once `npm run db:start`
# has printed your local Supabase keys.

# --- Supabase (local: printed by `npm run db:start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Local development only: every visitor is signed in as this verified admin
# (created on first use). Needs `next dev` and a local Supabase URL; production
# builds ignore it. Remove the line to test real sign-in.
DEV_AUTO_LOGIN_EMAIL=admin@wisc.edu

# --- AI (docs/ARCHITECTURE.md §6b) ---
# fixture = recorded/stub answers, no network, $0 (default)
# live    = call the providers below
# record  = call live providers and save answers as fixtures for offline replay
AI_MODE=fixture

# Short structured jobs (profile summaries, search parsing)
AI_EXTRACT_PROVIDER=ollama            # ollama | openai-compatible | anthropic
AI_EXTRACT_MODEL=gpt-oss:20b
# Prose ("why this person", outreach drafts)
AI_WRITE_PROVIDER=ollama
AI_WRITE_MODEL=gpt-oss:20b
# Embeddings: must be 1024-dimensional to match the database column
AI_EMBED_PROVIDER=ollama              # ollama | openai-compatible
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIMENSIONS=1024

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Live AI: Google Gemini's free tier (set GEMINI_API_KEY below), then set:
#   AI_MODE=live
#   AI_EXTRACT_PROVIDER=gemini
#   AI_EXTRACT_MODEL=gemini-3.1-flash-lite
#   AI_WRITE_PROVIDER=gemini
#   AI_WRITE_MODEL=gemini-3.1-flash-lite
#   AI_EMBED_PROVIDER=fixture            # until a 1024-dim embedding model is chosen
# Any other OpenAI-compatible API (e.g. OpenRouter ":free" models) uses the two
# lines below with AI_*_PROVIDER=openai-compatible. NVIDIA's free API was too slow.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Web search for enrichment (optional; free tier is 1,000 searches/month at https://tavily.com).
# Without it, enrichment uses only the bios on the institution's own profile pages.
TAVILY_API_KEY=

# Optional Claude fallback for low-confidence or invalid answers
AI_FALLBACK=none                      # none | anthropic
AI_FALLBACK_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Rate limiting (optional locally; in-memory fallback) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Background jobs ---
# Local: talk to `npm run inngest:dev` instead of Inngest Cloud. Remove in production.
INNGEST_DEV=1
# Production only:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Google Gemini (free tier: create a key at https://aistudio.google.com/apikey) ---
# Paste your key after the = sign (model settings are in the AI block above).
# Note: on the free tier Google may use prompts and responses to improve its products.
GEMINI_API_KEY=

# --- Web search for enrichment ---
# Default: self-hosted SearXNG (npm run search:start), free and keyless.
# SEARXNG_URL=http://127.0.0.1:8888
# SEARXNG_GAP_MS=6000        # pause between searches; engines suspend fast clients
# To use Tavily instead (spends its free monthly quota): SEARCH_PROVIDER=tavily
