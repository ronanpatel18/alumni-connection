# Copy to .env.local. Values below work for local development once `npm run db:start`
# has printed your local Supabase keys.

# --- Supabase (local: printed by `npm run db:start`) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses row-level security; never expose to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- AI (docs/ARCHITECTURE.md §6b) ---
# fixture = recorded/stub answers, no network, $0 (default)
# live    = call the providers below
# record  = call live providers and save answers as fixtures for offline replay
AI_MODE=fixture

# Short structured jobs (profile summaries, search parsing)
AI_EXTRACT_PROVIDER=ollama            # ollama | openai-compatible | anthropic
AI_EXTRACT_MODEL=gpt-oss:20b
# Prose ("why this person", outreach drafts)
AI_WRITE_PROVIDER=ollama
AI_WRITE_MODEL=gpt-oss:20b
# Embeddings: must be 1024-dimensional to match the database column
AI_EMBED_PROVIDER=ollama              # ollama | openai-compatible
AI_EMBED_MODEL=bge-m3
AI_EMBED_DIMENSIONS=1024

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Hosted models via any OpenAI-compatible API. Default choice: a FREE model from
# models.dev (https://models.dev/api.json, cost 0): MiniMax M3.1 Flash on NVIDIA.
# (DeepSeek V4.1 Flash is also free there but stalled under load on 2026-11-03.)
# Get a free key at https://build.nvidia.com, then set:
#   AI_MODE=live
#   AI_EXTRACT_PROVIDER=openai-compatible
#   AI_EXTRACT_MODEL=minimaxai/minimax-m3.1-flash
#   AI_WRITE_PROVIDER=openai-compatible
#   AI_WRITE_MODEL=minimaxai/minimax-m3.1-flash
#   AI_EMBED_PROVIDER=fixture            # until a 1024-dim embedding model is chosen
# Other free options on models.dev: OpenRouter ":free" models (https://openrouter.ai/api/v1).
OPENAI_COMPAT_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_COMPAT_API_KEY=

# Web search for enrichment (optional; free tier is 1,000 searches/month at https://tavily.com).
# Without it, enrichment uses only the bios on the institution's own profile pages.
TAVILY_API_KEY=

# Optional Claude fallback for low-confidence or invalid answers
AI_FALLBACK=none                      # none | anthropic
AI_FALLBACK_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=

# --- Rate limiting (optional locally; in-memory fallback) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Background jobs ---
# Local: talk to `npm run inngest:dev` instead of Inngest Cloud. Remove in production.
INNGEST_DEV=1
# Production only:
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
