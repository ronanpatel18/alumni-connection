{
  "name": "alumni-connection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "inngest:dev": "npx --yes inngest-cli@1.49.0 dev -u http://127.0.0.1:3000/api/inngest",
    "dev:promote": "tsx --env-file=.env.local scripts/dev-promote.ts",
    "dev:summaries": "tsx --env-file=.env.local scripts/summarize-local.ts",
    "import:wsb-boards": "tsx --env-file=.env.local scripts/import-wsb-boards.ts",
    "enrich": "tsx --env-file=.env.local scripts/enrich-people.ts",
    "class-years": "tsx --env-file=.env.local scripts/find-class-years.ts",
    "linkedin": "tsx --env-file=.env.local scripts/import-linkedin.ts",
    "search:start": "test -f searxng/.env || echo \"SEARXNG_SECRET=$(openssl rand -hex 32)\" > searxng/.env; docker compose -f searxng/docker-compose.yml up -d",
    "search:stop": "docker compose -f searxng/docker-compose.yml down",
    "deploy:db": "bash scripts/deploy-database.sh",
    "design:sync": "node scripts/sync-design-css.mjs",
    "links:generate": "tsx --env-file=.env.local scripts/generate-profile-links.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "fflate": "^0.8.2",
    "inngest": "^4.26.2",
    "next": "16.4.5",
    "openai": "^7.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-pgvector": "^0.0.16",
    "@electric-sql/pglite-postgis": "^0.2.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
